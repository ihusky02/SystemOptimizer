<Window x:Class="SystemOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor Zasobów" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#202020" Foreground="White" FontFamily="Segoe UI Variable">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#005FB8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Monitor Zasobów" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Użycie CPU:" FontSize="16" Foreground="#CCCCCC"/>
            <ProgressBar x:Name="CpuProgressBar" Height="20" Minimum="0" Maximum="100" Margin="0,5,0,15" Foreground="#0078D4"/>
            <TextBlock x:Name="CpuText" Text="0%" HorizontalAlignment="Right" Margin="0,-35,5,15" Foreground="White"/>

            <TextBlock Text="Dostępny RAM:" FontSize="16" Foreground="#CCCCCC"/>
            <ProgressBar x:Name="RamProgressBar" Height="20" Minimum="0" Maximum="16000" Margin="0,5,0,15" Foreground="#107C10"/>
            <TextBlock x:Name="RamText" Text="0 MB" HorizontalAlignment="Right" Margin="0,-35,5,15" Foreground="White"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Otwórz Narzędzia Oczyszczania" Height="40" FontSize="14" Click="OpenTools_Click"/>
    </Grid>
</Window>