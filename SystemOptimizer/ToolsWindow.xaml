<Window x:Class="SystemOptimizer.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Narzędzia Czyszczenia" Height="380" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#202020" Foreground="White" FontFamily="Segoe UI Variable">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3d3d3d"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3d3d3d"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="Narzędzia Konserwacji" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <Button Content="Czyszczenie pozostałości po Windows Store" Click="CleanWinStore_Click"/>
            <Button Content="Czyszczenie pozostałości po Windows Update" Click="CleanWinUpdate_Click"/>
            <Button Content="Czyszczenie po aktualizacjach sterowników" Click="CleanDrivers_Click"/>
            <Button Content="Usuń folder Windows.old" Click="CleanWindowsOld_Click"/>

            <Button Content="Usuń oporny folder (Wymuś uprawnienia)" 
                    Click="DeleteStubbornFolder_Click" 
                    Background="#A80000" 
                    BorderBrush="#C00000"
                    FontWeight="SemiBold"
                    Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>